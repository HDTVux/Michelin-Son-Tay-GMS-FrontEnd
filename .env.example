# URL gốc của backend (Spring Boot). Mặc định http://localhost:8080 nếu bỏ trống.
VITE_API_BASE_URL=http://localhost:8080

# Khoá VAPID PUBLIC dùng cho Web Push (thông báo đẩy cấp hệ điều hành).
# Sinh cặp khoá VAPID ở backend (public/private), dán public key vào đây.
# Đây là khoá công khai — an toàn để nhúng vào bản build FE.
# Thiếu biến này thì nút "Bật thông báo trên thiết bị này" sẽ tự ẩn.
VITE_VAPID_PUBLIC_KEY=
